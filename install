#!/usr/bin/env bash
set -euo pipefail

# Single entrypoint for all platforms.
# On Windows (Git Bash/MSYS/Cygwin), delegate to PowerShell.
case "${OSTYPE:-}" in
  msys*|cygwin*|win32*)
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cd "$(dirname "$0")" && pwd)/scripts/install-windows.ps1" "$@"
    ;;
  *)
    exec bash "$(cd "$(dirname "$0")" && pwd)/scripts/install-unix.sh" "$@"
    ;;
esac
