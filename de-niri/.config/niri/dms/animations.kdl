animations {
    on
    slowdown 0.5
    workspace-switch {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=800 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=800 epsilon=0.001
    }
    screenshot-ui-open {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.001
    }
    overview-open-close {
        spring damping-ratio=0.8 stiffness=200 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.001
    }
}
